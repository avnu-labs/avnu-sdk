{
  "compilerOptions": {
    "target": "ES2020",
    // tsup's dts build injects a deprecated `baseUrl`; silence it until tsup drops it.
    "ignoreDeprecations": "6.0",
    "lib": [
      "ES2020",
      "es7",
      "es6",
      "dom"
    ],
    "module": "commonjs",
    "types": [
      "jest",
      "node"
    ],
    "declaration": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
